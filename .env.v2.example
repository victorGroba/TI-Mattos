# HelpDesk v2 — copie para .env.v2 na raiz do projeto:
#
#   cp .env.v2.example .env.v2
#
# NÃO copie para .env: esse nome já é do sistema antigo em Flask, que guarda
# nele SECRET_KEY, MAIL_USERNAME e MAIL_PASSWORD. Sobrescrever derruba o que
# está no ar.
#
# Depois, use sempre --env-file .env.v2 nos comandos do compose.
# O arquivo preenchido nunca deve ser versionado (já está no .gitignore).

# ---------- Banco ----------
POSTGRES_USER=helpdesk
POSTGRES_DB=helpdesk
# Gere com:  openssl rand -hex 24
#
# Hexadecimal de propósito: esta senha entra dentro da URL de conexão
# (postgresql://usuario:SENHA@db:5432/banco), e caracteres como / + @ que o
# base64 produz quebram essa URL — com um erro que não menciona a senha.
POSTGRES_PASSWORD=

# ---------- Aplicação ----------
# Assina os cookies de sessão. Trocar este valor desloga todo mundo.
# Gere com:  openssl rand -hex 32
AUTH_SECRET=
APP_URL=https://helpdesk.ti-labmattos.online

# ---------- E-mail ----------
# Sem SMTP_USER/SMTP_PASSWORD o envio é desligado explicitamente e registrado
# no log — nunca falha em silêncio, que foi o problema do sistema antigo.
SMTP_HOST=email-ssl.com.br
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ti@labmattos.com.br
SMTP_PASSWORD=
MAIL_FROM=HelpDesk Lab Mattos <ti@labmattos.com.br>

# ---------- Primeiro acesso ----------
# Lidos apenas pelo seed, e só quando ainda não existe nenhum administrador.
# Depois do primeiro deploy pode remover estas três linhas.
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
